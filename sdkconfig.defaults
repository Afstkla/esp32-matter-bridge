# esp32s3, 16 MB QIO flash, 8 MB OPI PSRAM at 80 MHz.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_matter_16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_matter_16mb.csv"

# esp_console needs sole ownership of the USB-Serial-JTAG peripheral; a
# secondary log console on the same port corrupts REPL input.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_FREERTOS_HZ=1000

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Matter's data model is the single largest consumer of heap on this device and
# the Arduino build ran out of internal DRAM at four accessories. Everything the
# stack allocates dynamically goes to PSRAM instead.
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=32
CONFIG_MAX_FABRICS=5

# BLE is only ever the commissioning transport: NimBLE with the roles a
# peripheral never plays left out, torn down once a fabric is joined.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y

# Operational discovery is IPv6 mDNS (CHIP's own minimal responder, which is on
# by default). Stock lwIP has neither SLAAC nor room for the addresses a
# commissioned node ends up holding.
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

CONFIG_MBEDTLS_HKDF_C=y

# The whole point of the port: dynamic frequency scaling plus automatic light
# sleep, configured at runtime by powerBegin(). DFS_INIT_AUTO only decides what
# the device does between startup and that call.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Without these, `power locks` can only say which locks exist, not what they
# cost: profiling adds per-lock held time, time in each DFS mode, the
# light-sleep taken/rejected counters, and per-timer trigger counts. That is
# the whole measurement for the drain hunt, so it stays on until the drain is
# understood.
CONFIG_PM_PROFILING=y
CONFIG_ESP_TIMER_PROFILING=y

# app_main builds the data model, and the WiFi/IP events CHIP subscribes to run
# on the system event task; both overflow the stock stacks.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
